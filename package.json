{
  "name": "omni-ade",
  "productName": "omni",
  "version": "0.0.1",
  "description": "Keyboard-driven agentic development environment",
  "main": "./out/main/index.js",
  "bin": {
    "omni": "bin/omni.mjs",
    "omni-mcp": "bin/omni-mcp.mjs",
    "omni-browser-mcp": "bin/omni-browser-mcp.mjs"
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-rebuild -f -w node-pty",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/cdp.mjs",
    "e2e:persist": "bash e2e/persist.sh",
    "e2e:revive": "bash e2e/revive.sh",
    "e2e:upgrade": "bash e2e/upgrade.sh",
    "package": "electron-vite build && electron-builder --mac dir && codesign --force --deep --sign - dist/mac-arm64/omni.app",
    "install-app": "bash scripts/install-app.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "6.3.0",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-ligatures": "0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.55.0",
    "markdown-it": "^15.0.2",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript-language-server": "6.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/diff": "^8.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.0",
    "vitest": "^3.2.7"
  }
}
